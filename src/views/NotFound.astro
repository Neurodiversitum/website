---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/Footer.astro';
import Logo from '@/components/Logo.astro';
import T from '@/components/T.astro';
import Link from '@/components/Link.astro';
import { dict } from '@/data/copy';
import { asLanguage, copyText } from '@/lib/i18n';

const lang = asLanguage(Astro.currentLocale);
const t = (path: string) => copyText(dict, lang, path);
---

<BaseLayout
  title={t('meta.notFound')}
  description={t('meta.notFoundDescription')}
>
  <section class="page">
    <div class="wrap not-found">
      <Logo class="logo-mark" />
      <T section="meta" name="notFound" as="h1" />
      <T section="meta" name="notFoundBody" as="p" class="page-lede" />
      <Link class="btn primary" href="/">
        <T section="meta" name="backHome" />
      </Link>
    </div>
    <div class="wrap">
      <Footer />
    </div>
  </section>
</BaseLayout>
