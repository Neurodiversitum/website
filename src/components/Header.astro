---
// Header of the design study: the brand with the animated atom, the centred navigation with a
// gliding glass pill and the Join button, the settings. Logic in src/lib/chrome.ts.
import T from './T.astro';
import Link from './Link.astro';
import { dict } from '@/data/copy';
import { site } from '@/data/site';
import {
  LOCALES,
  asLanguage,
  copyText,
  localePath,
  pagePath,
  stripLocale,
} from '@/lib/i18n';

interface Props {
  active?: string;
}
const { active = '' } = Astro.props;
const lang = asLanguage(Astro.currentLocale);
const basePath = stripLocale(pagePath(Astro.url.pathname));
const t = (path: string) => copyText(dict, lang, path);
// On narrow screens the links show as icons, so the Join button always fits.
const links = [
  [
    'about',
    '/about',
    'common.about',
    'M12 11v5M12 7.7v.1M20.5 12a8.5 8.5 0 1 1-17 0 8.5 8.5 0 0 1 17 0z',
  ],
  [
    'projects',
    '/projects',
    'common.projects',
    'M8.6 14.6a5 5 0 1 1 6.8 0c-.8.8-1.2 1.6-1.2 2.6H9.8c0-1-.4-1.8-1.2-2.6zM10 20.3h4',
  ],
  [
    'events',
    '/events',
    'common.events',
    'M7 5.5h10a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-8a3 3 0 0 1 3-3zM4 10h16M8.5 3.5V7M15.5 3.5V7',
  ],
  [
    'team',
    '/team',
    'common.team',
    'M12 9a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM3.8 18.5c.8-2.8 2.8-4.2 5.2-4.2s4.4 1.4 5.2 4.2M19 8.4a2.4 2.4 0 1 1-4.8 0 2.4 2.4 0 0 1 4.8 0zM15.7 13.6c2.2-.2 3.9 1 4.6 3.5',
  ],
] as const;
const inMembers = basePath.startsWith('/members');
const languages: Record<(typeof LOCALES)[number], string> = {
  en: 'English',
  de: 'Deutsch',
};
const orbit = 'M10,50 a40,15.5 0 1,0 80,0 a40,15.5 0 1,0 -80,0';
---

<a class="skip-link" href="#main">
  <T section="common" name="skip" />
</a>
<header class="site-header">
  <div class="header-inner">
    <Link class="brand glass" href="/" aria-label={t('meta.homeLink')}>
      <svg viewBox="0 0 100 100" aria-hidden="true" data-mark>
        <g transform="rotate(0 50 50)">
          <path id="mark-o1" class="orb" d={orbit}></path>
        </g>
        <g transform="rotate(60 50 50)">
          <path id="mark-o2" class="orb" d={orbit}></path>
        </g>
        <g transform="rotate(120 50 50)">
          <path id="mark-o3" class="orb" d={orbit}></path>
        </g>
        <circle class="core" cx="50" cy="50" r="8"></circle>
        <g transform="rotate(0 50 50)">
          <circle class="dot" r="4.2">
            <animateMotion dur="6s" repeatCount="indefinite">
              <mpath href="#mark-o1"></mpath>
            </animateMotion>
          </circle>
        </g>
        <g transform="rotate(60 50 50)">
          <circle class="dot" r="4.2">
            <animateMotion
              dur="7.5s"
              repeatCount="indefinite"
              keyPoints="1;0"
              keyTimes="0;1"
              calcMode="linear"
            >
              <mpath href="#mark-o2"></mpath>
            </animateMotion>
          </circle>
        </g>
        <g transform="rotate(120 50 50)">
          <circle class="dot" r="4.2">
            <animateMotion dur="9s" repeatCount="indefinite">
              <mpath href="#mark-o3"></mpath>
            </animateMotion>
          </circle>
        </g>
      </svg>
      <span>{site.name}</span>
    </Link>
    <nav class="nav glass" aria-label={t('meta.mainNav')}>
      <span class="nav-pill" aria-hidden="true"></span>
      {links.map(([key, href, label, icon]) => (
        <Link
          class="nav-link"
          href={href}
          data-nav={key}
          aria-current={active === key ? 'page' : undefined}
        >
          <svg
            class="nav-ico"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={icon}></path>
          </svg>
          <T path={label} class="nav-label" />
        </Link>
      ))}
      <Link
        class="btn primary small away"
        href="/join"
        data-nav-join
        tabindex="-1"
        aria-hidden="true"
      >
        <T section="common" name="navJoin" />
      </Link>
    </nav>
    <div class="tools-wrap">
      <div class="tools glass">
        <Link
          class="icon-btn"
          href="/members"
          aria-label={t('common.membersLink')}
          aria-current={inMembers ? 'page' : undefined}
          data-members-link
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="8.8" r="3.4"></circle>
            <path d="M5.6 19.2c1-3.1 3.4-4.7 6.4-4.7s5.4 1.6 6.4 4.7"></path>
          </svg>
        </Link>
        <button
          class="icon-btn"
          type="button"
          aria-expanded="false"
          aria-controls="settings"
          aria-label={t('common.settings')}
          data-settings-open
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path>
            <circle cx="16" cy="7" r="2.4"></circle>
            <circle cx="10" cy="17" r="2.4"></circle>
          </svg>
        </button>
      </div>
      <div
        class="settings glass"
        id="settings"
        role="dialog"
        aria-label={t('common.settings')}
        data-settings-panel
        data-layer="settings"
      >
        <div class="set-row">
          <label>
            <T section="common" name="pauseMotion" />
            <input
              class="switch"
              type="checkbox"
              role="switch"
              id="pref-motion"
              data-pref="motion"
            />
          </label>
          <T section="common" name="pauseMotionHint" as="small" />
        </div>
        <div class="set-row">
          <label>
            <T section="common" name="easyReading" />
            <input
              class="switch"
              type="checkbox"
              role="switch"
              id="pref-font"
              data-pref="font"
            />
          </label>
          <T section="common" name="easyReadingHint" as="small" />
        </div>
        <div class="set-row">
          <label>
            <T section="common" name="embedsAllow" />
            <input
              class="switch"
              type="checkbox"
              role="switch"
              id="pref-embeds"
              data-pref="embeds"
            />
          </label>
          <T section="common" name="embedsHint" as="small" />
        </div>
        <div class="set-row">
          <div class="label-row">
            <T section="common" name="language" />
            <span
              class="langs"
              role="group"
              aria-label={t('meta.switchLanguage')}
            >
              {LOCALES.map((code) => (
                <a
                  href={localePath(code, basePath)}
                  hreflang={code}
                  lang={code}
                  aria-current={code === lang ? 'true' : undefined}
                >
                  {code.toUpperCase()}
                  <span class="sr-only">{languages[code]}</span>
                </a>
              ))}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
