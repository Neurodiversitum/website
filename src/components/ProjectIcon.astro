---
// The line icon of a project in the study style (quiet zones, lighting, lectures), with a
// neutral orbit for any other project from Notion.
interface Props {
  slug: string;
}
const { slug } = Astro.props;
const icons: Record<string, string[]> = {
  'quiet-zones': ['M6 27V11l10-6 10 6v16', 'M12.5 27v-8h7v8'],
  'ambient-lighting': [
    'M10.5 18a5.5 5.5 0 1 1 11 0c0 2.2-1.3 3.4-2.2 4.6-.5.7-.8 1.4-.8 2.4h-5c0-1-.3-1.7-.8-2.4-.9-1.2-2.2-2.4-2.2-4.6z',
    'M13.5 28h5',
    'M16 4v3',
  ],
  'shorter-lectures': [
    'M16 5a11 11 0 1 0 0 22a11 11 0 1 0 0-22z',
    'M16 10v6l4 3',
  ],
};
const paths = icons[slug] ?? [
  'M4 16a12 4.6 0 1 0 24 0a12 4.6 0 1 0-24 0z',
  'M16 13.5a2.5 2.5 0 1 0 0 5a2.5 2.5 0 1 0 0-5z',
];
---

<svg
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  aria-hidden="true"
>
  {paths.map((d) => (
    <path d={d} />
  ))}
</svg>
