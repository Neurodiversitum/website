---
// The closing section of a page, as in the design study: a centred heading, one line, the
// button and the club address, the legal links at the bottom.
import Section from './Section.astro';
import T from './T.astro';
import Link from './Link.astro';
import { dict } from '@/data/copy';
import { site } from '@/data/site';
import { asLanguage, copyText } from '@/lib/i18n';

interface Props {
  /** Copy paths. */
  title: string;
  body: string;
  button?: string;
  href?: string;
  /** The button is the "Join the club" button: the Join pill in the header steps aside. */
  join?: boolean;
  mail?: boolean;
}
const {
  title,
  body,
  button,
  href = '/join',
  join = false,
  mail = true,
} = Astro.props;
const label = copyText(dict, asLanguage(Astro.currentLocale), title);
---

<Section label={label} class="cta-sec" foot>
  <T path={title} as="h2" data-build />
  <T path={body} as="p" data-build style="--i:1" />
  {button && (
    <div data-build style="--i:2">
      <Link class="btn primary" href={href} data-join={join ? '' : undefined}>
        <T path={button} />
      </Link>
    </div>
  )}
  {mail && (
    <span class="mail" data-build style="--i:3">
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </span>
  )}
</Section>
