# Copy to .env (build) and fill in. Never commit the real file.

# Notion integration token for the content sync (Team, Projects, Events).
# Without it the build uses the committed src/data/content.json.
NOTION_TOKEN=YOUR_NOTION_TOKEN
NOTION_TEAM_DB=YOUR_NOTION_TEAM_DB_ID
NOTION_PROJECTS_DB=YOUR_NOTION_PROJECTS_DB_ID
NOTION_EVENTS_DB=YOUR_NOTION_EVENTS_DB_ID
